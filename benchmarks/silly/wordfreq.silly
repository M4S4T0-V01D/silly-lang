# Word frequencies: format N pseudo-random words, join them into one text,
# split it again, count with a hash map and print the most common words.

fn main():
    let a = args()
    let n = a[1].parse_int().unwrap() if len(a) > 1 else 100000
    var words: list[str] = []
    var s: u64 = 42
    for _ in 0..n:
        s = s * 6364136223846793005 + 1442695040888963407
        words.push(f"w{(s >> 33) % 50000}")
    let text = " ".join(words)
    var counts: map[str, int] = {}
    for w in text.split(" "):
        counts[w] = counts.get_or(w, 0) + 1
    var ranked: list[(int, str)] = []
    for w, c in counts.items():
        ranked.push((-c, w))
    ranked.sort()
    print(len(counts))
    for i in 0..5:
        let (c, w) = ranked[i]
        print(w, -c)
