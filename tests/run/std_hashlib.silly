# hashlib digests, hmac, crc32 against known vectors

import hashlib

fn main():
    print(hashlib.md5(""))
    print(hashlib.md5("The quick brown fox jumps over the lazy dog"))
    print(hashlib.sha1("abc"))
    print(hashlib.sha256("abc"))
    print(hashlib.sha256(""))
    print(hashlib.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
    print(hashlib.sha512("abc"))
    print(hashlib.hmac_sha256("key", "The quick brown fox jumps over the lazy dog"))
    print(hashlib.hmac_md5("key", "The quick brown fox jumps over the lazy dog"))
    print(hashlib.hmac_sha1("key", "The quick brown fox jumps over the lazy dog"))
    print(hashlib.crc32("hello"))
    print(hashlib.crc32("The quick brown fox jumps over the lazy dog"))
    var long = ""
    for _ in 0..1000:
        long += "a"
    print(hashlib.sha256(&long))
    print(hashlib.sha512(&long))
    let raw = hashlib.sha256_bytes("abc")
    print(len(raw), hashlib.hex(&raw))
    let bs: list[u8] = [0, 255, 128, 65]
    let s = hashlib.from_bytes(&bs)
    print(len(s), s.bytes())
    print(hashlib.equal("abc", "abc"), hashlib.equal("abc", "abd"), hashlib.equal("a", "ab"))
    var k = ""
    for _ in 0..200:
        k += "k"
    print(hashlib.hmac_sha256(&k, "m"), hashlib.hmac_sha512(&k, "m").len())

