# difflib: opcodes, unified_diff, ratio, close matches (matches Python)

import difflib

fn main():
    let a = "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm".split("\n")
    let b = "a\nB\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\nn".split("\n")
    for l in difflib.unified_diff(&a, &b, &"x", &"y", 3):
        print(l)
    for l in difflib.unified_diff(&["1", "2"], &["1", "2"], &"x", &"y", 3):
        print(l)
    for l in difflib.unified_diff(&[], &["new"], &"x", &"y", 1):
        print(l)
    for l in difflib.unified_diff(&["only"], &[], &"x", &"y", 0):
        print(l)
    let m = difflib.matcher(&"x y z w q".split(" "), &"y q z w x".split(" "))
    for o in m.opcodes():
        print(o.str())
    for s in [("kitten", "sitting"), ("abcd", "bcde"), ("", ""), ("private Thread currentThread;", "private volatile Thread currentThread;"), ("abxcd", "abcd")]:
        print(difflib.ratio(&s.0, &s.1))
    print(difflib.get_close_matches(&"appel", &["ape", "apple", "peach", "puppy"], 3, 0.6))
    print(difflib.get_close_matches(&"wheel", &["while", "where", "wheat", "whale", "heel"], 3, 0.6))
    print(difflib.diff_text(&"one\ntwo\nthree", &"one\n2\nthree\nfour", &"old", &"new"))

