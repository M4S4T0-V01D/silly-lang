# base64, base32 and hex encode/decode

import base64

fn show(r: Result[str, str]):
    match r:
        case Ok(s): print("ok", s)
        case Err(e): print("err", e)

fn main():
    for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar"]:
        print(base64.encode(&s), base64.b32_encode(&s), base64.hex_encode(&s))
        show(base64.decode(&base64.encode(&s)))
        show(base64.b32_decode(&base64.b32_encode(&s)))
    print(base64.urlsafe_encode("\u{fb}\u{ff}"), base64.encode("\u{fb}\u{ff}"), base64.urlsafe_encode_nopad("\u{fb}\u{ff}"))
    show(base64.urlsafe_decode("w7vDvw=="))
    show(base64.decode("aGVs\nbG8="))
    show(base64.decode("aGVsbG8"))
    show(base64.decode("aGVsbG8=x"))
    show(base64.decode("aGV*"))
    show(base64.decode("a"))
    show(base64.hex_decode("68656c6C6f"))
    show(base64.hex_decode("6"))
    show(base64.hex_decode("6g"))

