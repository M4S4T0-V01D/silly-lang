# datetime: dates, ISO weeks, durations, strftime, parsing (checked against Python)

import datetime as dt
fn main():
    let ds = [dt.date(2024, 2, 28), dt.date(1, 1, 1), dt.date(9999, 12, 31), dt.date(2020, 12, 31), dt.date(2021, 1, 3), dt.date(2008, 12, 29), dt.date(1900, 3, 1), dt.date(2000, 2, 29)]
    for d in ds:
        let ic = d.isocalendar()
        print(d.isoformat(), d.ordinal(), d.weekday(), d.yearday(), ic.0, ic.1, ic.2, dt.from_ordinal(d.ordinal()) == d.clone())
        print(d.strftime(&"%a %A %w %u %d %e %b %B %m %y %Y %j %U %W %V %G %x %%"), "|", d.ctime())
    let a = dt.date(2024, 1, 31)
    print(a.add_months(1).isoformat(), a.add_months(-13).isoformat(), a.add_days(400).isoformat(), dt.date(2024, 3, 1).sub(a).str())
    let t = dt.datetime_us(2024, 3, 1, 21, 5, 9, 1234)
    print(t.isoformat(), t.isoformat_sep(" "), t.strftime(&"%H %I %p %M %S %f %c %X"))
    print(t.add(dt.hours(-30)).isoformat(), t.add(dt.timedelta(400, 3, -5)).isoformat())
    let b = dt.datetime(2023, 12, 31, 23, 59, 59)
    for x in [t.sub(b), b.sub(t), dt.timedelta(0, 0, 1), dt.timedelta(-1, 0, 0), dt.timedelta(2, 3600, 500000), dt.seconds(-1), dt.days(0)]:
        print(x.str(), x.days(), x.seconds(), x.microseconds(), x.total_seconds())
    print(dt.hours(25).ratio(dt.hours(2)), dt.minutes(7).div(2).str(), t.compare(b), b.before(t))
    print(t.floor(dt.hours(1)).isoformat(), b.timestamp_utc(), dt.utc_from_timestamp(1700000000.5).isoformat())
    print(dt.from_isocalendar(2020, 53, 5).isoformat(), dt.from_isocalendar(2024, 1, 1).isoformat())
    for s in ["2024-03-01", "20240301", "2024-02-30", "2024-3-01", "x"]:
        match dt.parse_date(&s):
            case Ok(d): print("ok", d.isoformat())
            case Err(e): print("err", e)
    for s in ["2024-03-01T12:30", "2024-03-01 12:30:15.5", "2024-03-01T12", "2024-03-01T25:00", "2024-03-01T12:30:15.1234567", "20240301T010203"]:
        match dt.parse_datetime(&s):
            case Ok(d): print("ok", d.isoformat())
            case Err(e): print("err", e)
    print(dt.time_of_day(9, 5, 0).isoformat(), dt.time_us(0, 0, 0, 50).isoformat(), dt.time_of_day(13, 0, 0).strftime(&"%I:%M %p"))
    let n = dt.now()
    print(n.year >= 2024, dt.today().year == n.year)

