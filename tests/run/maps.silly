# Insertion-ordered hash maps living on the data stack.

struct Inv:
    counts: map[str, int]
    tags: map[int, list[str]]

fn word_counts(text: str) -> map[str, int]:
    var m: map[str, int] = {}
    for w in text.split(" "):
        if w in m:
            m[w] += 1
        else:
            m[w] = 1
    return m

fn squares(n: int) -> map[int, int]:
    var m: map[int, int] = {}
    for i in 0..n:
        m[i] = i * i
    return m

fn total(m: &map[str, int]) -> int:
    var t = 0
    for k, v in m.items():
        t += v
    return t

fn main():
    var ages = {"ann": 31, "bob": 27, "cy": 45}
    print(ages, len(ages))
    ages["bob"] = 28
    ages["dee"] = 19
    ages["ann"] += 1
    print(ages)
    print("cy" in ages, "zed" in ages, "zed" not in ages)
    print(ages.get("cy"), ages.get("zed"), ages.get_or("zed", -1))
    print(ages.remove("cy"), ages.remove("cy"), len(ages))
    print(ages.insert("eve", 50), ages.insert("eve", 51), ages["eve"])
    for name in ages:
        print(name, end=" ")
    print()
    for i, name in enumerate(ages):
        print(i, name, end="; ")
    print()
    print(ages.keys(), ages.values())
    print(ages.items())
    print(total(&ages))

    let wc = word_counts("the cat and the dog and the bird")
    print(wc)

    # growth, removal and reinsertion
    var sq = squares(1000)
    var sum = 0
    for k in sq:
        sum += sq[k]
    print(len(sq), sum, sq[999])
    for i in 0..1000:
        if i % 3 != 0:
            sq.remove(i)
    print(len(sq), sq.get(3), sq.get(4), sq.keys()[0:5])
    for i in 0..10:
        sq[i] = -i
    print(len(sq), sq[1], sq[3])
    sq.clear()
    print(sq, sq.is_empty())
    sq[7] = 49
    print(sq)

    # tuple keys, list values
    var grid: map[(int, int), str] = {}
    grid[(0, 0)] = "origin"
    grid[(2, -1)] = "east"
    print(grid[(2, -1)], (0, 0) in grid, (1, 1) in grid)

    var groups: map[int, list[str]] = {}
    for w in ["a", "bb", "cc", "ddd", "e"]:
        let n = len(w)
        if n not in groups:
            groups[n] = []
        groups[n].push(w.upper())
    print(groups)
    for k, v in groups.items():
        print(k, len(v))

    # equality is order-insensitive, clone is deep
    let a = {1: "x", 2: "y"}
    let b = {2: "y", 1: "x"}
    print(a == b, a == {1: "x"}, a != b)
    var g2 = groups.clone()
    g2[1].push("Z")
    print(len(groups[1]), len(g2[1]))

    var inv = Inv({}, {})
    for i in 0..5:
        inv.counts[f"k{i % 2}"] = i
        inv.tags[i] = [f"t{i}"]
    print(inv)
    var chars: map[char, int] = {}
    for c in "mississippi":
        chars[c] = chars.get_or(c, 0) + 1
    print(chars)
#> {"ann": 31, "bob": 27, "cy": 45} 3
#> {"ann": 32, "bob": 28, "cy": 45, "dee": 19}
#> true false true
#> Some(45) None -1
#> Some(45) None 3
#> None Some(50) 51
#> ann bob dee eve 
#> 0 ann; 1 bob; 2 dee; 3 eve; 
#> ["ann", "bob", "dee", "eve"] [32, 28, 19, 51]
#> [("ann", 32), ("bob", 28), ("dee", 19), ("eve", 51)]
#> 130
#> {"the": 3, "cat": 1, "and": 2, "dog": 1, "bird": 1}
#> 1000 332833500 998001
#> 334 Some(9) None [0, 3, 6, 9, 12]
#> 340 -1 -3
#> {} true
#> {7: 49}
#> east true false
#> {1: ["A", "E"], 2: ["BB", "CC"], 3: ["DDD"]}
#> 1 2
#> 2 2
#> 3 1
#> true false false
#> 2 3
#> Inv(counts={"k0": 4, "k1": 3}, tags={0: ["t0"], 1: ["t1"], 2: ["t2"], 3: ["t3"], 4: ["t4"]})
#> {'m': 1, 'i': 4, 's': 4, 'p': 2}
