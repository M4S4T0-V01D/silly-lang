# Silly Core only: the self-hosted compiler must also run this (see tests/selfhost_test.py).

const LIMIT: int = 5
const GREETING: str = "hello"

struct Point:
    x: int
    y: int

struct Shape:
    name: str
    corners: list[Point]

enum Token:
    Num(int)
    Word(str)
    Pair(int, int)
    End

enum Color:
    Red
    Green
    Blue

fn area2(s: &Shape) -> int:
    # Twice the signed area (shoelace).
    var total = 0
    let n = len(s.corners)
    for i in 0..n:
        let a = s.corners[i]
        let b = s.corners[(i + 1) % n]
        total += a.x * b.y - b.x * a.y
    return total

fn shift(p: &mut Point, dx: int, dy: int):
    p.x += dx
    p.y += dy

fn describe(t: &Token) -> str:
    match t:
        case Num(n) if n < 0:
            return "negative " + str(-n)
        case Num(0):
            return "zero"
        case Num(1..=9):
            return "digit"
        case Num(n):
            return "number " + str(n)
        case Word("hi") | Word("hello"):
            return "greeting"
        case Word(w):
            return "word " + w
        case Pair(a, b):
            return "pair " + str(a + b)
        case End:
            return "end"

fn color_name(c: Color) -> str:
    match c:
        case Color.Red:
            return "red"
        case Green:
            return "green"
        case _:
            return "other"

fn half(n: int) -> Result[int, str]:
    if n % 2 != 0:
        return Err(str(n) + " is odd")
    return Ok(n // 2)

fn quarter(n: int) -> Result[int, str]:
    let h = half(n)?
    return half(h)

fn first_even(xs: &list[int]) -> Option[int]:
    for x in xs:
        if x % 2 == 0:
            return Some(x)
    return None

fn fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn main():
    # arithmetic and operators
    print(7 // 2, -7 // 2, 7 % 3, -7 % 3, 2 ** 10, 1 << 4, 0xff & 0x0f, 0b101 | 0o10, 6 ^ 3, ~0)
    print(fib(15), LIMIT * 2, GREETING)
    var k = 10
    k -= 3
    k *= 4
    k //= 3
    k %= 5
    k <<= 2
    print(k)
    let flag = k > 3 and not (k == 100) or false
    print(flag, 3 if flag else 4)
    let b: u8 = 200
    print(b, (b as int) + 100)

    # structs and references
    var p = Point(1, 2)
    shift(&mut p, 10, 20)
    print(p.x, p.y)
    let sq = Shape("square", [Point(0, 0), Point(2, 0), Point(2, 2), Point(0, 2)])
    print(sq.name, area2(&sq), len(sq.corners))
    var copy = sq.clone()
    copy.corners[0].x = 5
    print(sq.corners[0].x, copy.corners[0].x)

    # enums and match
    let toks = [Token.Num(-4), Token.Num(0), Token.Num(7), Token.Num(42), Token.Word("hi"), Token.Word("tree"), Token.Pair(3, 4), Token.End]
    for t in toks:
        print(describe(&t))
    print(color_name(Color.Red), color_name(Color.Green), color_name(Color.Blue))

    # Result, Option and ?
    match quarter(12):
        case Ok(v):
            print("quarter", v)
        case Err(e):
            print("error", e)
    match quarter(6):
        case Ok(v):
            print("quarter", v)
        case Err(e):
            print("error", e)
    print(half(8).unwrap(), half(3).is_err(), half(3).unwrap_or(-1))
    let evens = [3, 5, 8, 9]
    print(first_even(&evens).unwrap(), first_even(&[1]).is_none())

    # loops
    var total = 0
    for i in 1..=4:
        total += i
    for i in range(3):
        total += i * 100
    var n = 0
    while n < 100:
        n += 1
        if n % 2 == 0:
            continue
        if n > 7:
            break
        total += n
    var spins = 0
    loop:
        spins += 1
        if spins == 3:
            break
    print(total, n, spins)

    assert total > 0, "total must be positive"
    assert len(toks) == 8

# expected output
#> 3 -4 1 2 1024 16 15 13 5 -1
#> 610 10 hello
#> 16
#> true 3
#> 200 300
#> 11 22
#> square 8 4
#> 0 5
#> negative 4
#> zero
#> digit
#> number 42
#> greeting
#> word tree
#> pair 7
#> end
#> red green other
#> quarter 3
#> error 3 is odd
#> 4 true -1
#> 8 true
#> 326 9 3
