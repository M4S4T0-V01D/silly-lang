const LIMIT: int = 5

fn fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn classify(n: int) -> str:
    if n < 0:
        return "neg"
    elif n == 0:
        return "zero"
    else:
        return "pos"

fn main():
    print(fib(20))
    print(classify(-3), classify(0), classify(9))
    var i = 0
    var acc = 0
    while i < LIMIT:
        acc += i * i
        i += 1
    print(acc)
    var n = 0
    loop:
        n += 3
        if n > 10:
            break
    print(n)
    let big = 7 if n > 5 else 1
    print(big, 17 // 5, 17 % 5, -7 // 2, -7 % 2, 2 ** 10)
    print(1.5 + 2.25, 10 / 4, 10.0 / 4.0, 3 == 3, not true, true and false or true)
    print(0xff, 0b101, 1_000_000, 'a', "tab\tend")
    let x: u8 = 250
    print(x, x as int + 10, 3.99 as int, 65 as char)
    print(abs(-4), min(3, 9), max(2.5, 1.0))
#> 6765
#> neg zero pos
#> 30
#> 12
#> 7 3 2 -4 1 1024
#> 3.75 2 2.5 true false true
#> 255 5 1000000 a tab	end
#> 250 260 3 A
#> 4 3 2.5
