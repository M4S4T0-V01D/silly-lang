fn main():
    var s = ""
    for i in 0..5:
        s = s + str(i)
    print(s)
    var t = 0
    for i in 1..=4:
        t += i
    print(t)
    var xs: list[int] = []
    for i in range(10, 0, -3):
        xs.push(i)
    print(xs)
    var ys: list[int] = []
    for i in range(0, 10, 4):
        ys.push(i)
    print(ys)
    var zs: list[int] = []
    for i in 0..10:
        if i % 2 == 0:
            continue
        if i > 7:
            break
        zs.push(i)
    print(zs)
    for i, c in enumerate("héllo"):
        if i == 1:
            print(c)
    var count = 0
    for c in "naïve":
        count += 1
    print(count, len("naïve"))
    let arr = [10, 20, 30]
    for i, v in enumerate(arr):
        print(i, v)
    var u8s: list[u8] = []
    for b in 250..=255:
        u8s.push(b as u8)
    print(u8s)
    var empty = 0
    for i in 5..5:
        empty += 1
    for i in 5..=4:
        empty += 1
    print(empty)
#> 01234
#> 10
#> [10, 7, 4, 1]
#> [0, 4, 8]
#> [1, 3, 5, 7]
#> é
#> 5 6
#> 0 10
#> 1 20
#> 2 30
#> [250, 251, 252, 253, 254, 255]
#> 0
