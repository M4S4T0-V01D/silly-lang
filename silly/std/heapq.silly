# Binary min-heaps kept in a plain list, like Python's heapq.
#
#     import heapq
#     fn main():
#         var h: list[int] = []
#         for x in [5, 1, 4, 2]:
#             heapq.push(&mut h, x)
#         print(heapq.pop(&mut h), heapq.pop(&mut h))     # Some(1) Some(2)
#         print(heapq.nsmallest(&[9, 3, 7, 1], 2))         # [1, 3]
#
# h[0] is always the smallest item. For a max-heap push negated numbers, or
# tuples (priority, item) to order items by priority.

fn _up[T: Ord](h: &mut list[T], at: int):
    var i = at
    while i > 0:
        let parent = (i - 1) / 2
        if not (h[i] < h[parent]):
            break
        h.swap(i, parent)
        i = parent

fn _down[T: Ord](h: &mut list[T], at: int):
    let n = len(h)
    var i = at
    while true:
        let l = 2 * i + 1
        if l >= n:
            break
        var c = l
        if l + 1 < n and h[l + 1] < h[l]:
            c = l + 1
        if not (h[c] < h[i]):
            break
        h.swap(i, c)
        i = c

# Adds x to the heap h.
fn push[T: Ord](h: &mut list[T], x: T):
    h.push(x)
    _up(&mut h, len(h) - 1)

# Removes and returns the smallest item.
fn pop[T: Ord](h: &mut list[T]) -> Option[T]:
    let n = len(h)
    if n == 0:
        return None
    h.swap(0, n - 1)
    let top = h.pop()
    if n > 1:
        _down(&mut h, 0)
    return Some(top)

# Pushes x, then pops the smallest; faster than push followed by pop.
fn pushpop[T: Ord](h: &mut list[T], x: T) -> T:
    if len(h) == 0 or not (h[0] < x):
        return x
    h.push(x)
    let n = len(h)
    h.swap(0, n - 1)
    let top = h.pop()
    _down(&mut h, 0)
    return top

# Pops the smallest, then pushes x.
fn replace[T: Ord](h: &mut list[T], x: T) -> Option[T]:
    let top = pop(&mut h)
    push(&mut h, x)
    return top

# The smallest item without removing it.
fn peek[T: Ord + Copy](h: &list[T]) -> Option[T]:
    if len(h) == 0:
        return None
    return Some(h[0])

# Rearranges a list into heap order in linear time.
fn heapify[T: Ord](h: &mut list[T]):
    var i = len(h) / 2 - 1
    while i >= 0:
        _down(&mut h, i)
        i -= 1

# The n smallest items, smallest first.
fn nsmallest[T: Ord](xs: &list[T], n: int) -> list[T]:
    var h = xs.clone()
    heapify(&mut h)
    var out: list[T] = []
    while len(out) < n:
        match pop(&mut h):
            case Some(x): out.push(x)
            case None: break
    return out

# The n largest items, largest first.
fn nlargest[T: Ord](xs: &list[T], n: int) -> list[T]:
    var s = xs.clone()
    s.sort()
    var out: list[T] = []
    while len(out) < n and len(s) > 0:
        out.push(s.pop())
    return out

# Merges lists that are each already sorted into one sorted list.
fn merge[T: Ord](lists: &list[list[T]]) -> list[T]:
    var all: list[T] = []
    for xs in lists:
        all.extend(xs.clone())
    all.sort()
    return all
