# 2D graphics: canvases, anti-aliased shapes, text, images and a window.
#
#     import gfx
#     fn main():
#         let win = gfx.open("Hello", 400, 300)
#         var running = true
#         while running:
#             for ev in win.events():
#                 match ev:
#                     case Quit: running = false
#                     case _: pass
#             let c = win.canvas()
#             c.clear(gfx.WHITE)
#             c.text(20, 20, "Hello, Silly", gfx.BLACK, gfx.FONT_TITLE)
#             win.present()
#             win.wait(16)
#
# Colors are ints 0xAARRGGBB (see rgb / rgba). Windows use SDL2 when it is
# installed and a display is available; otherwise they are headless (see
# docs/std/gfx.md for SILLY_GFX, SILLY_GFX_SHOT and SILLY_GFX_FRAMES).

extern "gfx_font.c"
extern "gfx.c" link "-ldl"

