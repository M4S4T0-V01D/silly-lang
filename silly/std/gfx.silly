extern fn gx_fill_rect(id: int, x: int, y: int, w: int, h: int, color: int)
extern fn gx_rect(id: int, x: int, y: int, w: int, h: int, t: int, color: int)
extern fn gx_set_pixel(id: int, x: int, y: int, color: int)
extern fn gx_get_pixel(id: int, x: int, y: int) -> int
extern fn gx_blend_pixel(id: int, x: int, y: int, color: int)
extern fn gx_fill_round_rect(id: int, x: int, y: int, w: int, h: int, r: int, color: int)
extern fn gx_round_rect(id: int, x: int, y: int, w: int, h: int, r: int, t: int, color: int)
extern fn gx_fill_circle(id: int, cx: f64, cy: f64, r: f64, color: int)
extern fn gx_circle(id: int, cx: f64, cy: f64, r: f64, t: f64, color: int)
extern fn gx_line(id: int, x0: f64, y0: f64, x1: f64, y1: f64, w: f64, color: int)
